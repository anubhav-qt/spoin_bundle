# The Hono stack's local settings (ADR-0106). Committed on purpose: every value here is
# for a database on this machine that holds nothing real. Never put a production
# secret in this file, and never point it at the old project's `db` (spoin_db_2).
DATABASE_URL=postgres://spoin:spoin@localhost:5434/spoin
UNIVERSE_DATABASE_URL=postgres://spoin:spoin@localhost:5434/the_spoin_universe
AUTH_SECRET=spoin-local-development-secret-change-me
ALLOWED_ORIGINS=http://localhost:3000
EMBEDDER=hash
DEV_ROUTES=true
