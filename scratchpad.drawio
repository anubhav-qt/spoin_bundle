try relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p52" value="fetch: HTTP, then Chromium" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;strokeColor=#9673a6;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p42" target="p48"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1065" y="696"/><mxPoint x="1815" y="696"/><mxPoint x="1815" y="750"/></Array></mxGeometry></mxCell><mxCell id="p53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="p42" target="p44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p54" value="handover" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p44" target="p45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p55" value="review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="p45" target="p44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p56" value="go_on" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="p44" target="p46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p57" value="handover" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p46" target="p47"><mxGeometry relative="1" as="geometry"></mxG