{
  "name": "@spoin/frog",
  "version": "0.1.0",
  "private": true,
  "description": "Retrieval (ADR-0087): the corpus store, its embedder and ingestion. A library, never imports @spoin/server",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/universe/schema.ts",
    "./db": "./src/universe/db.ts",
    "./embeddings": "./src/embeddings.ts",
    "./normalize": "./src/normalize.ts",
    "./retrieval": "./src/retrieval.ts",
    "./ingest/*": "./src/ingest/*.ts",
    "./curriculum/*": "./src/curriculum/*.ts",
    "./images/*": "./src/images/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "db:generate": "drizzle-kit generate",
    "corpus:check": "node --env-file-if-exists=../../infra/dev.env src/ingest/cli.ts --check",
    "corpus:ingest": "node --env-file-if-exists=../../infra/dev.env src/ingest/cli.ts",
    "curriculum:check": "node --env-file-if-exists=../../infra/dev.env src/curriculum/cli.ts --check",
    "curriculum:ingest": "node --env-file-if-exists=../../infra/dev.env src/curriculum/cli.ts",
    "images:check": "node --env-file-if-exists=../../infra/dev.env src/images/cli.ts --check",
    "images:ingest": "node --env-file-if-exists=../../infra/dev.env src/images/cli.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "yaml": "2.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "vitest": "5.0.3"
  }
}
