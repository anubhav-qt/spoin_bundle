<mxfile host="65bd71144e"><diagram id="spoinPipeline" name="pipeline"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="2670" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3" value="&lt;b style='font-size:20px'&gt;spoin: one topic, from a reader's request to live cards&lt;/b&gt;" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;yellow: reader, web app&lt;br&gt;grey: code (no model)&lt;br&gt;blue: Gemini, through CLIProxyAPI&lt;br&gt;green: NVIDIA NIM writers, through the Balancer&lt;br&gt;purple: stores&lt;br&gt;arrow label: the record that wakes the chat it points at" style="fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;spacingLeft=8;verticalAlign=top;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="330" height="150" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;How chats wake&lt;/b&gt;&lt;br&gt;Chats never call each other. A tool stores a record (brief, report, handover,&lt;br&gt;review, gate, verdicts, art...). Every tick the scheduler routes new records&lt;br&gt;to the chats that read them and wakes those chats: routeNewRecords,&lt;br&gt;routeNewJobs, startTadpoles, wakeDueChats. Each review is go on or change;&lt;br&gt;a change sends the work back to the chat that handed it over." style="fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;spacingLeft=8;verticalAlign=top;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="80" width="520" height="150" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b&gt;Checks are code, not models&lt;/b&gt;&lt;br&gt;Tools refuse what breaks a rule and say why: the document contract,&lt;br&gt;map rules (evidence, order, check-by dates), anchors that are exact&lt;br&gt;headings, card quotas and limits, MCQ shape, near-duplicates (0.92).&lt;br&gt;The chat fixes it and calls again." style="fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;spacingLeft=8;verticalAlign=top;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="80" width="480" height="150" as="geometry"/></mxCell><mxCell id="p7" value="&lt;b&gt;Reader + web app&lt;/b&gt;" style="fillColor=#e6e6e6;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="280" width="230" height="44" as="geometry"/></mxCell><mxCell id="p8" value="" style="fillColor=none;strokeColor=#cccccc;dashed=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="330" width="230" height="2280" as="geometry"/></mxCell><mxCell id="p9" value="&lt;b&gt;Worker: scheduler (code)&lt;/b&gt;" style="fillColor=#e6e6e6;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="280" width="230" height="44" as="geometry"/></mxCell><mxCell id="p10" value="" style="fillColor=none;strokeColor=#cccccc;dashed=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="330" width="230" height="2280" as="geometry"/></mxCell><mxCell id="p11" value="&lt;b&gt;toad_sage (Gemini)&lt;/b&gt;" style="fillColor=#e6e6e6;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="280" width="230" height="44" as="geometry"/></mxCell><mxCell id="p12" value="" style="fillColor=none;strokeColor=#cccccc;dashed=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="330" width="230" height="2280" as="geometry"/></mxCell><mxCell id="p13" value="&lt;b&gt;tadpole, one per topic (Gemini)&lt;/b&gt;" style="fillColor=#e6e6e6;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="280" width="230" height="44" as="geometry"/></mxCell><mxCell id="p14" value="" style="fillColor=none;strokeColor=#cccccc;dashed=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="330" width="230" height="2280" as="geometry"/></mxCell><mxCell id="p15" value="&lt;b&gt;tadpole's helpers&lt;/b&gt;" style="fillColor=#e6e6e6;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="280" width="230" height="44" as="geometry"/></mxCell><mxCell id="p16" value="" style="fillColor=none;strokeColor=#cccccc;dashed=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="330" width="230" height="2280" as="geometry"/></mxCell><mxCell id="p17" value="&lt;b&gt;curriculum chat (Gemini)&lt;/b&gt;" style="fillColor=#e6e6e6;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="280" width="230" height="44" as="geometry"/></mxCell><mxCell id="p18" value="" style="fillColor=none;strokeColor=#cccccc;dashed=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="330" width="230" height="2280" as="geometry"/></mxCell><mxCell id="p19" value="&lt;b&gt;designer_toad (Gemini)&lt;/b&gt;" style="fillColor=#e6e6e6;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580" y="280" width="230" height="44" as="geometry"/></mxCell><mxCell id="p20" value="" style="fillColor=none;strokeColor=#cccccc;dashed=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580" y="330" width="230" height="2280" as="geometry"/></mxCell><mxCell id="p21" value="&lt;b&gt;Stores&lt;/b&gt;" style="fillColor=#e6e6e6;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1810" y="280" width="230" height="44" as="geometry"/></mxCell><mxCell id="p22" value="" style="fillColor=none;strokeColor=#cccccc;dashed=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1810" y="330" width="230" height="2280" as="geometry"/></mxCell><mxCell id="p23" value="&lt;b&gt;1. Intake&lt;/b&gt;" style="fillColor=#f9f7ed;strokeColor=#cccccc;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="150" height="360" as="geometry"/></mxCell><mxCell id="p24" value="" style="line;strokeColor=#cccccc;dashed=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="330" width="1840" height="2" as="geometry"/></mxCell><mxCell id="p25" value="&lt;b&gt;2. Research&lt;/b&gt;" style="fillColor=#f9f7ed;strokeColor=#cccccc;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="150" height="360" as="geometry"/></mxCell><mxCell id="p26" value="" style="line;strokeColor=#cccccc;dashed=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="690" width="1840" height="2" as="geometry"/></mxCell><mxCell id="p27" value="&lt;b&gt;3. Documents&lt;/b&gt;" style="fillColor=#f9f7ed;strokeColor=#cccccc;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="150" height="360" as="geometry"/></mxCell><mxCell id="p28" value="" style="line;strokeColor=#cccccc;dashed=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="1050" width="1840" height="2" as="geometry"/></mxCell><mxCell id="p29" value="&lt;b&gt;4. Curriculum&lt;/b&gt;" style="fillColor=#f9f7ed;strokeColor=#cccccc;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="150" height="360" as="geometry"/></mxCell><mxCell id="p30" value="" style="line;strokeColor=#cccccc;dashed=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="1410" width="1840" height="2" as="geometry"/></mxCell><mxCell id="p31" value="&lt;b&gt;5. Cards&lt;/b&gt;" style="fillColor=#f9f7ed;strokeColor=#cccccc;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1770" width="150" height="480" as="geometry"/></mxCell><mxCell id="p32" value="" style="line;strokeColor=#cccccc;dashed=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="1770" width="1840" height="2" as="geometry"/></mxCell><mxCell id="p33" value="&lt;b&gt;6. Questions, live&lt;/b&gt;" style="fillColor=#f9f7ed;strokeColor=#cccccc;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="2250" width="150" height="360" as="geometry"/></mxCell><mxCell id="p34" value="" style="line;strokeColor=#cccccc;dashed=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="2250" width="1840" height="2" as="geometry"/></mxCell><mxCell id="p35" value="&lt;b&gt;Reader asks for a topic&lt;/b&gt;&lt;br&gt;topic row + generation_job&lt;br&gt;(pending, in queue order)" style="fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="215" y="342" width="200" height="96" as="geometry"/></mxCell><mxCell id="p36" value="&lt;b&gt;routeNewJobs&lt;/b&gt;&lt;br&gt;wakes toad_sage once&lt;br&gt;per new job" style="fillColor=#f5f5f5;strokeColor=#666666;rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445" y="342" width="200" height="96" as="geometry"/></mxCell><mxCell id="p37" value="&lt;b&gt;Intake&lt;/b&gt;&lt;br&gt;find_topics_by_name / _by_meaning&lt;br&gt;list_categories, read_topic, web_search&lt;br&gt;accept_topic | merge_topic | reject_topic&lt;br&gt;change_intake" style="fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="675" y="462" width="200" height="96" as="geometry"/></mxCell><mxCell id="p38" value="&lt;b&gt;startTadpoles&lt;/b&gt;&lt;br&gt;up to 4 jobs running at once:&lt;br&gt;next pending job with an intake&lt;br&gt;-&amp;gt; running, its tadpole woken" style="fillColor=#f5f5f5;strokeColor=#666666;rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445" y="582" width="200" height="96" as="geometry"/></mxCell><mxCell id="p39" value="generation_job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="p35" target="p36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p40" value="wake: job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="p36" target="p37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p41" value="intake record" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="p37" target="p38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p42" value="&lt;b&gt;Research&lt;/b&gt;&lt;br&gt;read_intake, search_corpus&lt;br&gt;web_search, fetch, read_page,&lt;br&gt;search_pages, list_documents" style="fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="905" y="702" width="200" height="96" as="geometry"/></mxCell><mxCell id="p43" value="&lt;b&gt;helper (Gemini)&lt;/b&gt;&lt;br&gt;tadpole's own prompt,&lt;br&gt;one brief -&amp;gt; report" style="fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1135" y="702" width="200" height="96" as="geometry"/></mxCell><mxCell id="p44" value="&lt;b&gt;Coverage note&lt;/b&gt;&lt;br&gt;hand_over(coverage)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="905" y="822" width="200" height="96" as="geometry"/></mxCell><mxCell id="p45" value="&lt;b&gt;review&lt;/b&gt;&lt;br&gt;go_on | change" style="fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;whiteS