# Spoin environment.
#
# Copy to .env and adjust. Every variable below has a safe local default already
# baked into docker-compose.yml, so `docker compose up` works with no .env at all.
# You only need this file when running things outside Docker, or when pointing at
# real providers.

# ---------------------------------------------------------------- database ----
# Local docker default. In production this is a Neon connection string; the driver
# stays the same (ADR-0003 §1 — scaling up must not change the connection shape).
SPOIN_DATABASE_URL=postgresql+asyncpg://spoin:spoin@localhost:5432/spoin

# ADR-0088: `the_spoin_universe` is the source-of-truth corpus database that
# frog reads. Its OWN variable, deliberately -- frog will not fall back to
# SPOIN_DATABASE_URL, because a convenience fallback is how a corpus migration
# lands on the production database. Create and migrate it with:
#     make universe-migrate
SPOIN_UNIVERSE_DATABASE_URL=postgresql+asyncpg://spoin:spoin@localhost:5432/the_spoin_universe

# ------------------------------------------------------------------- server ----
SPOIN_ENV=local
SPOIN_LOG_LEVEL=INFO
SPOIN_CORS_ORIGINS=http://localhost:3000

# -------------------------------------------------------------------- auth ----
# HS256 signing key for JWT tokens. MUST be changed in production.
SPOIN_JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
SPOIN_ACCESS_TOKEN_EXPIRE_MINUTES=30
SPOIN_REFRESH_TOKEN_EXPIRE_DAYS=7
# Google OAuth client ID — leave empty to disable Google sign-in.
SPOIN_GOOGLE_CLIENT_ID=
# Password for the seeded demo user (local dev / CI only).
SPOIN_SEED_USER_PASSWORD=demo1234

# Coverage threshold as a fraction of target_cards. Placeholder — content-model.md
# open questions flags 50-60% as the intuition pending real rejection-rate data.
SPOIN_MIN_CARDS_FRACTION=0.6

# ------------------------------------------------------------- generation -----
# Which ContentGenerator implementation to use (ADR-0002).
#   fake   deterministic, in-memory, no network, no quota. The default everywhere
#          except production — tests and local dev must never call a real model.
#   gemini cloud, quota-bound
#   local  local GPU via an OpenAI-compatible endpoint (ADR-0008)
SPOIN_GENERATOR=fake

# Comma-separated. Each entry must be its OWN Google Cloud project — Gemini rate
# limits are per-project, not per-key, so keys sharing a project share one quota
# pool (ADR-0028).
SPOIN_GEMINI_API_KEYS=

# Local GPU backend (ADR-0008). Never a serving dependency.
SPOIN_LOCAL_GENERATOR_BASE_URL=http://localhost:11434/v1
SPOIN_LOCAL_GENERATOR_MODEL=qwen3:14b

# ------------------------------------------------------------------ quota -----
# Per-key-per-model fallback ladders (ADR-0028/0029), "model:rpd:rpm,...",
# strongest model first. Live-verified 2026-08-17 against 9 real keys --
# gemini-2.5-flash and gemini-2.5-flash-lite are both retired for new
# accounts (404) and dropped; gemini-3.0-flash never existed as a stable
# name (only gemini-3-flash-preview does). ADR-0008's open question is
# resolved for THIS project's account; re-verify if it changes.
#   thinking   curriculum, topic matching, judging, quiz grading
#   generator  generate_cards AND generate_questions (ADR-0029) -- both are
#              high-volume, one-per-item prose, so they share the cheap ladder
SPOIN_GEMINI_THINKING_LADDER=gemini-3.7-flash:20:5,gemini-3.6-flash:20:5,gemini-3.5-flash:20:5,gemini-3-flash-preview:20:5
# How many rungs at the END of the thinking ladder are a RESERVE (ADR-0074) --
# reached only when no key anywhere has daily room on an ordinary rung, never
# because keys are merely busy. Contention waits; exhaustion descends.
SPOIN_GEMINI_THINKING_RESERVE_RUNGS=1
SPOIN_GEMINI_GENERATOR_LADDER=gemini-3.5-flash-lite:500:15,gemini-3.1-flash-lite:500:15

# -------------------------------------------------------------- embeddings ----
# Embeddings run locally and never against a quota'd API (hard rule 5).
#   hash       dependency-free deterministic stand-in. Fine for tests and for
#              seeing the app run; NOT semantically meaningful.
#   fastembed  BGE-small, CPU-only. Install with the `embeddings` extra.
SPOIN_EMBEDDER=hash
SPOIN_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Topic canonicalization bands (ADR-0004). PLACEHOLDERS — these are the numbers
# task 0001 exists to measure. They are model-specific and must be recalibrated
# whenever SPOIN_EMBEDDING_MODEL changes.
SPOIN_TOPIC_MERGE_HIGH=0.92
SPOIN_TOPIC_MERGE_LOW=0.80

# ------------------------------------------------------------------- feed -----
# Ranking weights (ADR-0010). Config so they can be tuned without a deploy.
SPOIN_RANK_W_QUALITY=1.0
SPOIN_RANK_W_AFFINITY=0.8
SPOIN_RANK_W_COVERAGE=0.6
SPOIN_RANK_W_FRESHNESS=0.3
SPOIN_RANK_EPSILON=0.10

SPOIN_SLATE_SIZE=25
SPOIN_PLAN_SIZE=50
SPOIN_SLATE_TTL_SECONDS=1800

# Degraded-mode hysteresis (ADR-0006 §3). Two thresholds, deliberately.
SPOIN_POOL_LOW=5
SPOIN_POOL_HIGH=15

# Dwell threshold for implicit completion, and the cap that stops a tab left open
# overnight from counting as a nine-hour read (ADR-0011).
SPOIN_DWELL_COMPLETE_MS=8000
SPOIN_DWELL_MAX_MS=300000

# -------------------------------------------------------------------- web -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Must match SPOIN_GOOGLE_CLIENT_ID above — the web app renders Google's own
# button (Google Identity Services), it never calls Google's API directly.
# Leave empty to render a disabled "Google sign-in not configured" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
