{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/server/**",
      "packages/shared/**",
      "packages/frog/**",
      "packages/pi-ai/**",
      "packages/pi-agent/**",
      "!**/drizzle/meta",
      "!**/dist",
      "!**/package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/pi-ai/**", "packages/pi-agent/**"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "apps/server/src/feed/**",
        "apps/server/src/engagement/**",
        "apps/server/src/cards/**",
        "apps/server/src/routes/feed.ts",
        "apps/server/src/routes/engagement.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "openai": "Hard rule 1: the feed read path never touches a model.",
                  "ai": "Hard rule 1: the feed read path never touches a model."
                },
                "patterns": [
                  {
                    "group": [
                      "@google/genai*",
                      "@google/generative-ai*",
                      "openai/*",
                      "@anthropic-ai/*",
                      "@ai-sdk/*",
                      "@mariozechner/pi-*",
                      "@spoin/pi-*"
                    ],
                    "message": "Hard rule 1: the feed read path never touches a model. Precompute a column instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/frog/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@spoin/server", "@spoin/server/*", "@spoin/shared", "@spoin/shared/*"],
                    "message": "frog never imports the server or the shared contract (ADR-0087): mirror the value and let a server test keep it equal."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
