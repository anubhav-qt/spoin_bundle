# ---- env / secrets ----
.env
.env.*
!.env.example

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
dist/
build/
*.egg-info/

# ---- node / next ----
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# ---- generated api types (regenerated from OpenAPI in CI) ----
packages/api-types/schema.d.ts

# ---- local model / generation artifacts ----
# Anchored to the repo root (leading slash) — a bare `models/` matches a
# directory of that name at ANY depth, which was silently excluding
# apps/api/src/spoin/domain/models/ (the actual SQLAlchemy schema,
# content-model.md's "highest-leverage" code) from version control entirely.
/models/
*.gguf
generated/

# ---- editors / os ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Claude Design seeded canvas payloads (~2MB editor bundle; re-seed from the .dc.html working files)
docs/design/mockups/**/spoin-*.html

# 14MB build artifact — belongs to the content-bundle build, not the repo (see ADR-0078 revert)
spoin-content-bundle.json.gz

# Neon backup runtime log — not source
scripts/neon_backup.log

# throwaway key->project clustering probe (not committed, see docs/handoff/next-key-projects-*.md)
.keyprobe/

# Research scratch for the corpus authoring loop (docs/the_spoin_universe/procedure.md
# Phase D). Wiped and rewritten per run, never ingested, never a deliverable -- the
# curated result under corpus/ is. The directory's README is kept so it survives.
docs/the_spoin_universe/temp/*
!docs/the_spoin_universe/temp/README.md

# Local database archives (pg_dump). Large, binary, and not source.
.archives/

# Retrieval-eval working files (task 0038 Phase 3). Both rebuild from
# scripts/eval/build_queries.py and scripts/eval/retrieve_pools.py; pools.json is ~1MB.
.eval/
